datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum WorkgroupRole {
  STRATEGIST
  STRATEGIST_ASSISTANT
  WRITER
  DESIGNER
  EDITOR
  VIDEOGRAPHER
  SOCIAL_ADMIN
  ONSITE_ADMIN
}

enum EvaluationStatus {
  PENDING
  COMPLETED
}


enum CommentType {
  STRATEGIST_EVALUATION
  WRITER_EVALUATION
  WRITER_FEEDBACK
  ROLE_EVALUATION
}

enum PointTransactionType {
  EVALUATION_COMPLETED
  FEEDBACK_GIVEN
  BONUS
  PENALTY
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  image     String?  // Profile picture URL
  
  isAdmin           Boolean  @default(false)
  isTechnicalDeputy Boolean  @default(false)
  
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workgroupMemberships      WorkgroupMember[]
  strategistEvaluations     StrategistEvaluation[] @relation("EvaluatedStrategist")
  evaluatorEvaluations      StrategistEvaluation[] @relation("Evaluator")
  writerEvaluations         WriterEvaluation[]     @relation("EvaluatedWriter")
  strategistAsEvaluator     WriterEvaluation[]     @relation("StrategistEvaluator")
  writerFeedbacks           WriterFeedback[]       @relation("FeedbackForWriter")
  strategistFeedbacks       WriterFeedback[]       @relation("FeedbackFromStrategist")
  comments                  Comment[]
  pointTransactions         PointTransaction[]
  totalPoints               Int                    @default(0)
  sentMessages              Message[]              @relation("SentMessages")
  receivedMessages          Message[]              @relation("ReceivedMessages")
  roleEvaluationsGiven      RoleEvaluation[]       @relation("RoleEvaluationEvaluator")
  roleEvaluationsReceived   RoleEvaluation[]       @relation("RoleEvaluationTarget")
  clientEvaluationsReceived ClientEvaluation[]     @relation("ClientEvaluationTarget")

  @@index([email])
  @@index([totalPoints])
}

model Workgroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members            WorkgroupMember[]
  writerEvaluations  WriterEvaluation[]
  writerFeedbacks    WriterFeedback[]
  roleEvaluations    RoleEvaluation[]
  clientBrands       ClientBrand[]
  clientEvaluations  ClientEvaluation[]

  @@index([name])
}

model WorkgroupMember {
  id          String        @id @default(cuid())
  workgroupId String
  userId      String
  role        WorkgroupRole
  createdAt   DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workgroup Workgroup @relation(fields: [workgroupId], references: [id], onDelete: Cascade)

  @@unique([workgroupId, userId, role])
  @@index([workgroupId])
  @@index([userId])
}

model StrategistEvaluation {
  id           String           @id @default(cuid())
  strategistId String
  evaluatorId  String
  month        Int
  year         Int
  status       EvaluationStatus @default(PENDING)

  ideation          Int
  avgViews          Int
  qualityControl    Int
  teamRelations     Int
  clientRelations   Int
  responsiveness    Int
  clientSatisfaction Int

  strengths       String?
  improvements    String?
  suggestions     String?
  evaluatorNotes  String?
  imageUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  strategist User @relation("EvaluatedStrategist", fields: [strategistId], references: [id])
  evaluator  User @relation("Evaluator", fields: [evaluatorId], references: [id])

  @@unique([strategistId, month, year])
  @@index([strategistId])
  @@index([evaluatorId])
  @@index([month, year])
}

model WriterEvaluation {
  id           String           @id @default(cuid())
  writerId     String
  strategistId String
  workgroupId  String
  month        Int
  year         Int
  status       EvaluationStatus @default(PENDING)

  responsibility            Int
  strategistSatisfaction    Int
  meetingEngagement         Int
  scenarioPerformance       Int
  clientSatisfaction        Int
  brandAlignment            Int

  strengths       String?
  improvements    String?
  suggestions     String?
  evaluatorNotes  String?
  imageUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  writer     User      @relation("EvaluatedWriter", fields: [writerId], references: [id])
  strategist User      @relation("StrategistEvaluator", fields: [strategistId], references: [id])
  workgroup  Workgroup @relation(fields: [workgroupId], references: [id], onDelete: Cascade)

  @@unique([writerId, strategistId, workgroupId, month, year])
  @@index([writerId])
  @@index([strategistId])
  @@index([workgroupId])
  @@index([month, year])
}

model WriterFeedback {
  id           String   @id @default(cuid())
  writerId     String
  strategistId String
  workgroupId  String
  month        Int
  year         Int
  
  communication   Int
  supportLevel    Int
  clarityOfTasks  Int
  feedbackQuality Int
  
  positivePoints String?
  improvements   String?
  suggestions    String?
  imageUrl       String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  writer     User      @relation("FeedbackForWriter", fields: [writerId], references: [id])
  strategist User      @relation("FeedbackFromStrategist", fields: [strategistId], references: [id])
  workgroup  Workgroup @relation(fields: [workgroupId], references: [id], onDelete: Cascade)

  @@unique([writerId, strategistId, workgroupId, month, year])
  @@index([strategistId])
  @@index([workgroupId])
  @@index([month, year])
}


/// Generic, role-driven monthly evaluation.
/// The metric keys stored in `scores` are defined per role in src/lib/roles.ts,
/// so adding a role or a KPI needs no schema change.
model RoleEvaluation {
  id            String           @id @default(cuid())
  workgroupId   String
  evaluatorId   String
  evaluatorRole WorkgroupRole
  targetId      String
  targetRole    WorkgroupRole
  month         Int
  year          Int
  status        EvaluationStatus @default(COMPLETED)

  /// { [metricKey]: 1..10 }
  scores       Json
  totalScore   Int
  averageScore Float

  /// Optional per-metric evaluator notes: { [metricKey]: string }
  metricNotes  Json?

  strengths    String?
  improvements String?
  example      String?
  suggestions  String?
  imageUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workgroup Workgroup @relation(fields: [workgroupId], references: [id], onDelete: Cascade)
  evaluator User      @relation("RoleEvaluationEvaluator", fields: [evaluatorId], references: [id])
  target    User      @relation("RoleEvaluationTarget", fields: [targetId], references: [id])

  @@unique([evaluatorId, targetId, targetRole, workgroupId, month, year], map: "RoleEvaluation_unique_per_period")
  @@index([evaluatorId])
  @@index([targetId])
  @@index([workgroupId])
  @@index([targetRole])
  @@index([month, year])
}

model Comment {
  id        String      @id @default(cuid())
  content   String
  type      CommentType
  
  // Reference to the evaluation/feedback
  evaluationId String    // Can be strategist eval, writer eval, or feedback ID
  
  authorId  String      // User who wrote the comment
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  author    User        @relation(fields: [authorId], references: [id])

  @@index([evaluationId])
  @@index([authorId])
  @@index([type])
}

model PointTransaction {
  id          String                @id @default(cuid())
  userId      String
  type        PointTransactionType
  points      Int                   // Can be positive or negative
  description String
  
  createdAt   DateTime              @default(now())

  user        User                  @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Message {
  id         String   @id @default(cuid())
  content    String
  
  senderId   String
  receiverId String
  
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@index([createdAt])
}

/// A brand-side contact who logs in through /client/login and rates the team
/// members working on their brands. Kept out of `User` on purpose: clients
/// never hold a WorkgroupRole, never appear in the team evaluation matrix and
/// must not reach the internal dashboard.
///
/// One person, one password — however many brands they own. The brands
/// themselves live in `ClientBrand`, so an owner of two clinics files both
/// months from a single login instead of juggling two accounts.
model ClientAccount {
  id       String  @id @default(cuid())
  email    String  @unique
  password String

  /// The person who signs in, written out in full — the small line under the
  /// brand in the portal header, e.g. «دکتر بیتا مجیدزاده».
  contactName String
  /// What the greeting calls them, when a shorter, warmer form reads better
  /// than the full contact name, e.g. «بیتا» for «بیتا جان، خوش آمدی».
  /// Falls back to `contactName` when empty.
  greetingName String?

  isActive Boolean @default(true)

  /// Admin-authored dashboard greeting. `{name}`, `{contact}` and `{brand}`
  /// are substituted at render time; both fall back to a default sentence
  /// when empty. The greeting speaks to the person, not to one brand, so it
  /// stays here and `{brand}` lists whatever brands they hold.
  welcomeTitle    String?
  welcomeMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands      ClientBrand[]
  evaluations ClientEvaluation[]

  @@index([email])
}

/// One brand a client account speaks for, bound to the workgroup that serves
/// it. A client with two brands answers the same questions twice — once per
/// brand — because the team's work differs per brand even when the people
/// overlap.
model ClientBrand {
  id       String @id @default(cuid())
  clientId String

  /// The headline of the portal header for this brand, e.g. «کلینیک گیتا».
  brandName   String
  workgroupId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client      ClientAccount      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workgroup   Workgroup          @relation(fields: [workgroupId], references: [id], onDelete: Cascade)
  evaluations ClientEvaluation[]

  /// One brand per workgroup per account: two brands served by the same
  /// workgroup would ask the client the same questions twice over.
  @@unique([clientId, workgroupId])
  @@index([clientId])
  @@index([workgroupId])
}

/// One client's monthly verdict on one team member in one role.
/// The whole form is submitted at once, so a period produces one row per
/// evaluated member. `skipped` records «تعامل کافی نداشتم» without scores.
model ClientEvaluation {
  id          String        @id @default(cuid())
  clientId    String
  /// Which of the client's brands this verdict is about.
  brandId     String
  workgroupId String
  targetId    String
  targetRole  WorkgroupRole
  month       Int
  year        Int

  /// True when the client declared they could not judge this person.
  skipped Boolean @default(false)

  /// { [metricKey]: 1..10 } — empty object when `skipped`.
  scores       Json
  totalScore   Int   @default(0)
  averageScore Float @default(0)

  /// { [questionKey]: string } — the role's open questions.
  answers Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)
  brand     ClientBrand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  workgroup Workgroup     @relation(fields: [workgroupId], references: [id], onDelete: Cascade)
  target    User          @relation("ClientEvaluationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([clientId, brandId, targetId, targetRole, month, year], map: "ClientEvaluation_unique_per_period")
  @@index([clientId])
  @@index([brandId])
  @@index([targetId])
  @@index([workgroupId])
  @@index([month, year])
}

/// Runtime settings an admin can change without a deploy, keyed by name.
/// `evaluationPeriod` → { month, year } pins the open KPI month; absent means
/// the current Persian calendar month.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
